 "lesson": {
  "slides": [
   {
    "id": "L1",
    "type": "dtrace",
    "title": "A function that is its own slope",
    "text": "Slide along $f(x) = e^x$ and drop its slopes on the lower graph. Compare the two graphs.",
    "fn": "exp(x)",
    "window": [
     -2,
     2,
     -0.5,
     7.5
    ],
    "dwindow": [
     -0.5,
     7.5
    ],
    "dstep": 1,
    "ystep": 1,
    "after": "The slopes make the **same** graph. $frac{d}{dx} e^x = e^x$. That is what makes $e$ special."
   },
   {
    "id": "L2",
    "type": "mc",
    "text": "With the chain rule: $frac{d}{dx} e^(f(x)) = e^(f(x))·f'(x)$. The exponent stays the same, and you multiply by its derivative. What is $frac{d}{dx} e^(sin(x))$?",
    "options": [
     "$e^(sin(x))cos(x)$",
     "$e^(cos(x))$",
     "$cos(x)e^x$",
     "$e^(sin(x))$"
    ],
    "answer": 0,
    "hint": "Keep $e^(sin(x))$, then multiply by the derivative of the exponent.",
    "explain": "$e^(sin(x))·cos(x)$"
   },
   {
    "id": "L3",
    "type": "expr",
