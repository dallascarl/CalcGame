   "questions": [
    {
     "id": "T1",
     "type": "tf",
     "text": "If $f$ is differentiable at $a$, then $f$ is continuous at $a$.",
     "answer": true,
     "explain": "Differentiable implies continuous."
    },
    {
     "id": "T2",
     "type": "tf",
     "text": "If $f$ is continuous at $a$, then $f$ is differentiable at $a$.",
     "answer": false,
     "explain": "$|x|$ is continuous at 0 but has a corner there, so it is not differentiable. The converse is not true."
    },
    {
     "id": "T3",
     "type": "pick",
     "text": "At which of these does the derivative **fail** to exist? Select all.",
     "options": [
      "a sharp corner",
      "a cusp",
      "a vertical tangent line",
      "a jump",
      "a smooth hilltop",
      "a point where $f(x) = 0$"
     ],
     "answers": [
      0,
      1,
      2,
      3
     ],
     "explain": "Corners, cusps, vertical tangents and breaks have no single slope. A smooth hilltop has slope 0, and $f(x) = 0$ says nothing about the slope."
    },
    {
     "id": "T4",
     "type": "mc",
     "text": "On an interval where $f$ is **increasing**, $f'$ is",
     "options": [
      "positive",
      "negative",
      "zero",
      "increasing"
     ],
     "answer": 0,
     "explain": "Rising graph, positive slopes."
    },
    {
     "id": "T5",
     "type": "mc",
     "text": "On an interval where $f$ is **decreasing**, the graph of $f'$ is",
     "options": [
      "below the $x$-axis",
      "above the $x$-axis",
      "on the $x$-axis",
      "decreasing"
     ],
     "answer": 0,
     "explain": "Falling graph, negative slopes."
    },
    {
     "id": "T6",
     "type": "match",
     "text": "Match each derivative of position $s(t)$ to its name.",
     "pairs": [
      [
       "$s'(t)$",
       "velocity"
      ],
      [
       "$s''(t)$",
       "acceleration"
      ],
      [
       "$s'''(t)$",
       "jerk"
      ]
     ],
     "explain": "Each is the rate of change of the one before."
    },
    {
     "id": "T7",
     "type": "mc",
     "text": "$frac{d^2 y}{dx^2}$ means",
     "options": [
      "the second derivative of $y$",
      "the derivative squared",
      "$y$ times 2",
      "the derivative of $x^2$"
     ],
     "answer": 0,
     "explain": "$frac{d^2y}{dx^2} = y''$: the derivative of the derivative."
    },
    {
     "id": "T8",
     "type": "mc",
     "text": "In $f'(x) = lim[h->0] frac{f(x+h) - f(x)}{h}$, the answer is a function of",
     "options": [
      "$x$",
      "$h$",
      "both $x$ and $h$",
      "neither"
     ],
     "answer": 0,
     "explain": "$h$ goes away in the limit. What is left depends on $x$: a slope for every $x$."
    }
   ]
