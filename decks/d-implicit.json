 "drills": {
  "theory": {
   "title": "Theory",
   "mode": "all",
   "questions": [
    {
     "id": "T1",
     "type": "mc",
     "text": "Why does $frac{d}{dx}(y^2)$ give $2y·y'$ and not just $2y$?",
     "options": [
      "$y$ depends on $x$, so the chain rule applies",
      "It is a typo; $2y$ is right",
      "Because of the product rule",
      "Because $y$ is a constant"
     ],
     "answer": 0,
     "explain": "We treat $y$ as $y(x)$. The derivative of the inside, $y$, is $y'$."
    },
    {
     "id": "T2",
     "type": "tf",
     "text": "$frac{d}{dx}(y^3) = 3y^2$",
     "answer": false,
     "explain": "$3y^2·y'$. Never forget the $y'$."
    },
    {
     "id": "T3",
     "type": "mc",
     "text": "$frac{d}{dx}(sin(y)) =$",
     "options": [
      "$cos(y)·y'$",
      "$cos(y)$",
      "$-cos(y)y'$",
      "$sin(y')$"
     ],
     "answer": 0,
     "explain": "Chain rule with $y$ inside."
    },
    {
     "id": "T4",
     "type": "mc",
     "text": "$frac{d}{dx}(x^2 y) =$",
     "options": [
      "$2xy + x^2 y'$",
      "$2xy'$",
      "$2xy$",
      "$x^2 y'$"
     ],
     "answer": 0,
     "explain": "Product rule: $(x^2)'y + x^2(y)'$."
    },
    {
     "id": "T5",
     "type": "order",
     "text": "Put the steps of implicit differentiation in order.",
     "items": [
      "Take $frac{d}{dx}$ of both sides",
      "Move every $y'$ term to one side",
      "Factor out $y'$",
      "Divide to solve for $y'$"
     ],
     "explain": "Differentiate, collect, factor, divide."
    },
    {
     "id": "T6",
     "type": "mc",
     "text": "To find the slope of the tangent line at $(a, b)$ from a formula for $y'$ in terms of $x$ and $y$, you",
     "options": [
      "plug in $x = a$ and $y = b$",
      "plug in only $x = a$",
      "set $y' = 0$",
      "solve the original equation for $y$ first"
     ],
     "answer": 0,
     "explain": "$y'$ usually depends on both $x$ and $y$, so use both coordinates."
    },
    {
     "id": "T7",
     "type": "tf",
     "text": "The derivative of a constant on the right side, like $x^2 + y^2 = 25$, is 0.",
     "answer": true,
     "explain": "25 never changes, so its derivative is 0."
    }
   ]
  },
