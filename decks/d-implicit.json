 "lesson": {
  "slides": [
   {
    "id": "L1",
    "type": "mc",
    "text": "$x^2 + y^2 = 1$ is a circle, not a function. We can still find slopes: take $frac{d}{dx}$ of **both sides**, treating $y$ as a function of $x$. Then $frac{d}{dx}(y^2) =$",
    "options": [
     "$2y·y'$",
     "$2y$",
     "$2x$",
     "$(y')^2$"
    ],
    "answer": 0,
    "hint": "$y^2$ is (something)$^2$, and the something depends on $x$. That's the chain rule.",
    "explain": "Chain rule: $2y$ times the derivative of the inside, $y'$. Every time you differentiate a $y$, a $y'$ appears."
   },
   {
    "id": "L2",
    "type": "steps",
    "text": "Find the slope of the circle $x^2 + y^2 = 25$ at the point $(3, 4)$.",
    "steps": [
     {
      "id": "L2.1",
      "type": "expr",
      "text": "Take $frac{d}{dx}$ of the left side.",
      "answer": "2x + 2yy'",
      "vars": [
       "x",
       "y",
       "y'"
      ],
      "keys": [
       "y'"
      ],
      "label": "$frac{d}{dx}(x^2 + y^2)$ =",
      "show": "$2x + 2yy'$",
      "hint": "$x^2 -> 2x$ and $y^2 -> 2y·y'$.",
      "work": "$2x + 2yy' = 0$"
     },
     {
      "id": "L2.2",
      "type": "expr",
      "text": "The right side, 25, has derivative 0. Solve $2x + 2yy' = 0$ for $y'$.",
      "answer": "-x/y",
      "vars": [
       "x",
       "y"
      ],
      "label": "$y'$ =",
      "show": "$-frac{x}{y}$",
      "hint": "Move $2x$ over, then divide by $2y$.",
      "work": "$y' = -frac{x}{y}$"
     },
     {
      "id": "L2.3",
      "type": "num",
      "text": "Plug in the point $(3, 4)$.",
      "answer": -0.75,
      "label": "slope =",
      "hint": "$-frac{3}{4}$",
      "work": "slope $= -frac{3}{4}$"
     }
    ]
   },
   {
    "id": "L3",
    "type": "expr",
    "text": "Products with $y$ need the product rule. Find $frac{d}{dx}(xy)$.",
    "answer": "y + xy'",
    "vars": [
     "x",
     "y",
     "y'"
    ],
    "keys": [
     "y'"
    ],
    "label": "$frac{d}{dx}(xy)$ =",
    "show": "$y + xy'$",
    "hint": "$(x)'·y + x·(y)'$",
    "explain": "$1·y + x·y'$"
   },
   {
    "id": "L4",
    "type": "steps",
    "text": "Find $frac{dy}{dx}$ for $x^3 sin(y) + y = 4x + 3$.",
    "steps": [
     {
      "id": "L4.1",
      "type": "expr",
      "text": "Left side: product rule on $x^3 sin(y)$, plus the derivative of $y$.",
      "answer": "3x^2sin(y) + x^3cos(y)y' + y'",
      "vars": [
       "x",
       "y",
       "y'"
      ],
      "keys": [
       "y'",
       "sin(",
       "cos(",
       "tan("
      ],
      "label": "left =",
      "show": "$3x^2sin(y) + x^3cos(y)y' + y'$",
      "hint": "$3x^2 sin(y) + x^3·cos(y)y' + y'$",
      "work": "$3x^2 sin(y) + x^3 cos(y)y' + y' = 4$"
     },
     {
      "id": "L4.2",
      "type": "mc",
      "text": "Get the $y'$ terms together and factor out $y'$:",
      "options": [
       "$y'(x^3 cos(y) + 1) = 4 - 3x^2 sin(y)$",
       "$y'(x^3 cos(y)) = 4$",
       "$y' = 4 - 3x^2 sin(y)$",
       "$y'(1 - x^3) = 4$"
      ],
      "answer": 0,
      "hint": "Move the term without $y'$ to the right side.",
      "work": "$y'(x^3 cos(y) + 1) = 4 - 3x^2 sin(y)$"
     },
     {
      "id": "L4.3",
      "type": "expr",
      "text": "Divide.",
      "answer": "(4 - 3x^2sin(y))/(x^3cos(y) + 1)",
      "vars": [
       "x",
       "y"
      ],
      "keys": [
       "sin(",
       "cos("
      ],
      "label": "$y'$ =",
      "ranges": {
       "x": [
        0.2,
        0.8
       ],
       "y": [
        0.2,
        0.8
       ]
      },
      "show": "$frac{4 - 3x^2sin(y)}{x^3cos(y) + 1}$",
      "hint": "Put ( ) around the top and around the bottom.",
      "work": "$y' = frac{4 - 3x^2 sin(y)}{x^3 cos(y) + 1}$"
     }
    ]
   },
   {
