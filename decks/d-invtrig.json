 "lesson": {
  "slides": [
   {
    "id": "L1",
    "type": "mc",
    "text": "$y = arcsin(x)$ (also written $sin^(-1)(x)$) means $sin(y) = x$. Differentiate implicitly: $cos(y)·y' = 1$, so $y' = frac{1}{cos(y)}$. A right triangle with opposite side $x$ and hypotenuse 1 shows $cos(y) = sqrt(1 - x^2)$. So $frac{d}{dx} arcsin(x) =$",
    "options": [
     "$frac{1}{sqrt(1 - x^2)}$",
     "$frac{1}{cos(x)}$",
     "$-frac{1}{sqrt(1 - x^2)}$",
     "$sqrt(1 - x^2)$"
    ],
    "answer": 0,
    "hint": "Put $sqrt(1 - x^2)$ in for $cos(y)$.",
    "explain": "$frac{d}{dx} arcsin(x) = frac{1}{sqrt(1 - x^2)}$"
   },
   {
    "id": "L2",
    "type": "match",
    "text": "The same trick gives the others. Match each function to its derivative.",
