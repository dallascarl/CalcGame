  "theory": {
   "title": "Theory",
   "mode": "all",
   "questions": [
    {
     "id": "T1",
     "type": "match",
     "text": "Match each function to its derivative.",
     "pairs": [
      [
       "$arcsin(x)$",
       "$frac{1}{sqrt(1 - x^2)}$"
      ],
      [
       "$arccos(x)$",
       "$-frac{1}{sqrt(1 - x^2)}$"
      ],
      [
       "$arctan(x)$",
       "$frac{1}{1 + x^2}$"
      ]
     ],
     "explain": "arccos is arcsin with a minus sign."
    },
    {
     "id": "T2",
     "type": "tf",
     "text": "$sin^(-1)(x)$ means $frac{1}{sin(x)}$.",
     "answer": false,
     "explain": "$sin^(-1)(x)$ is the inverse function $arcsin(x)$. $frac{1}{sin(x)}$ is $csc(x)$."
    },
    {
     "id": "T3",
     "type": "mc",
     "text": "Where does the formula $frac{d}{dx} arcsin(x) = frac{1}{sqrt(1 - x^2)}$ come from?",
     "options": [
      "Implicit differentiation of $sin(y) = x$",
      "The quotient rule",
      "The power rule",
      "The limit definition with $h = 0$"
     ],
     "answer": 0,
     "explain": "Write $sin(y) = x$, differentiate, and use a triangle to write $cos(y)$ in terms of $x$."
    },
    {
     "id": "T4",
     "type": "mc",
     "text": "$frac{d}{dx} arctan(g(x)) =$",
     "options": [
      "$frac{g'(x)}{1 + g(x)^2}$",
      "$frac{1}{1 + g'(x)^2}$",
      "$frac{1}{1 + g(x)^2}$",
      "$arctan(g'(x))$"
     ],
     "answer": 0,
     "explain": "Chain rule."
    },
    {
     "id": "T5",
     "type": "mc",
     "text": "What is $cos(arctan(x))$? (Draw a triangle with opposite $x$ and adjacent 1.)",
     "options": [
      "$frac{1}{sqrt(1 + x^2)}$",
      "$sqrt(1 + x^2)$",
      "$frac{x}{sqrt(1 + x^2)}$",
      "$sqrt(1 - x^2)$"
     ],
     "answer": 0,
     "explain": "The hypotenuse is $sqrt(1 + x^2)$, and cosine is adjacent over hypotenuse."
    },
    {
     "id": "T6",
     "type": "mc",
     "text": "$frac{d}{dx} sec^(-1)(x) =$",
     "options": [
      "$frac{1}{|x| sqrt(x^2 - 1)}$",
      "$sec(x)tan(x)$",
      "$frac{1}{1 + x^2}$",
      "$-frac{1}{sqrt(1 - x^2)}$"
     ],
     "answer": 0,
     "explain": "The less common ones: $sec^(-1)$ gives $frac{1}{|x|sqrt(x^2 - 1)}$, and $csc^(-1)$ and $cot^(-1)$ are the negatives of $sec^(-1)$ and $tan^(-1)$."
    }
   ]
  },
