 "lesson": {
  "slides": [
   {
    "id": "L1",
    "type": "mc",
    "text": "$arcsin(x)$ asks: which angle has sine equal to $x$? Only angles from $-frac{pi}{2}$ to $frac{pi}{2}$ count. What is $arcsin(frac{1}{2})$?",
    "options": [
     "$frac{pi}{6}$",
     "$frac{5pi}{6}$",
     "$frac{pi}{3}$",
     "$frac{1}{2}$"
    ],
    "answer": 0,
    "hint": "$sin(frac{pi}{6}) = frac{1}{2}$.",
    "explain": "$frac{5pi}{6}$ also has sine $frac{1}{2}$, but it is outside the range of arcsin."
   },
   {
    "id": "L2",
    "type": "match",
    "text": "Each inverse trig function returns angles in its own range. Match them.",
    "pairs": [
     [
      "$arcsin(x)$",
      "$[-frac{pi}{2}, frac{pi}{2}]$"
     ],
     [
      "$arccos(x)$",
      "$[0, pi]$"
     ],
     [
      "$arctan(x)$",
      "$(-frac{pi}{2}, frac{pi}{2})$"
     ]
    ],
    "hint": "arccos is the odd one out: it starts at 0.",
    "explain": "These ranges make each one a true function."
   }
  ]
 },
 "lessonOptional": true
}
