   "questions": [
    {
     "id": "T1",
     "type": "mc",
     "text": "$frac{d}{dx} ln(x) =$",
     "options": [
      "$frac{1}{x}$",
      "$ln(x)$",
      "$e^x$",
      "$frac{1}{ln(x)}$"
     ],
     "answer": 0,
     "explain": "One of the most-used derivatives in calculus."
    },
    {
     "id": "T2",
     "type": "mc",
     "text": "$frac{d}{dx} ln(g(x)) =$",
     "options": [
      "$frac{g'(x)}{g(x)}$",
      "$frac{1}{g(x)}$",
      "$frac{1}{g'(x)}$",
      "$ln(g'(x))$"
     ],
     "answer": 0,
     "explain": "Chain rule: $frac{1}{g(x)}·g'(x)$."
    },
    {
     "id": "T3",
     "type": "tf",
     "text": "$frac{d}{dx} ln(2x) = frac{1}{2x}$",
     "answer": false,
     "explain": "$frac{2}{2x} = frac{1}{x}$. (Or: $ln(2x) = ln(2) + ln(x)$, and $ln(2)$ is a constant.)"
    },
    {
     "id": "T4",
     "type": "match",
     "text": "Match the log rules.",
     "pairs": [
      [
       "$ln(ab)$",
       "$ln(a) + ln(b)$"
      ],
      [
       "$ln(frac{a}{b})$",
       "$ln(a) - ln(b)$"
      ],
      [
       "$ln(a^r)$",
       "$r ln(a)$"
      ],
      [
       "$ln(e)$",
       "$1$"
      ]
     ],
     "explain": "Use these to simplify before differentiating."
    },
    {
     "id": "T5",
     "type": "mc",
     "text": "$frac{d}{dx} log_b(x) =$",
     "options": [
      "$frac{1}{x ln(b)}$",
      "$frac{1}{x}$",
      "$frac{ln(b)}{x}$",
      "$b^x ln(b)$"
     ],
     "answer": 0,
     "explain": "$log_b(x) = frac{ln(x)}{ln(b)}$, and $ln(b)$ is a constant."
    },
    {
     "id": "T6",
     "type": "mc",
     "text": "The inverse function theorem says $(f^(-1))'(a) =$",
     "options": [
      "$frac{1}{f'(f^(-1)(a))}$",
      "$frac{1}{f'(a)}$",
      "$-f'(a)$",
      "$f'(f^(-1)(a))$"
     ],
     "answer": 0,
     "explain": "Find where $f$ takes the value $a$, take the slope of $f$ there, and flip it."
    },
    {
     "id": "T7",
     "type": "mc",
     "text": "The graph of $f^(-1)$ is the graph of $f$",
     "options": [
      "reflected over the line $y = x$",
      "reflected over the $x$-axis",
      "shifted up 1",
      "turned upside down"
     ],
     "answer": 0,
     "explain": "Swapping $x$ and $y$ reflects over $y = x$, which turns a slope $m$ into $frac{1}{m}$."
    }
   ]
  },
