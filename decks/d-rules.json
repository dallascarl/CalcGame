 "lesson": {
  "slides": [
   {
    "id": "L1",
    "type": "mc",
    "text": "**Power rule:** $frac{d}{dx} x^n = nx^(n-1)$. Bring the power down in front, then lower the power by one. What is $frac{d}{dx} x^5$?",
    "options": [
     "$5x^4$",
     "$x^4$",
     "$5x^5$",
     "$4x^5$"
    ],
    "answer": 0,
    "hint": "Bring the 5 down, then subtract 1 from the power.",
    "explain": "$5x^4$"
   },
   {
    "id": "L2",
    "type": "expr",
    "text": "Constants in front stay, and a sum is differentiated one term at a time. A constant alone has derivative 0. Find the derivative of $f(x) = 3x^2 + 2x + 1$.",
    "answer": "6x + 2",
    "vars": [
     "x"
    ],
    "label": "$f'(x)$ =",
    "show": "$6x + 2$",
    "hint": "$3x^2 -> 3·2x$, $2x -> 2$, and $1 -> 0$.",
    "explain": "$6x + 2$"
   },
   {
    "id": "L3",
    "type": "steps",
    "text": "**Product rule:** if $f = gk$ then $f' = gk' + g'k$. Take $f(x) = (x^2 + 2)(3x + 1)$ with $g = x^2 + 2$ and $k = 3x + 1$.",
    "steps": [
     {
      "id": "L3.1",
      "type": "expr",
      "answer": "2x",
      "vars": [
       "x"
      ],
      "label": "$g'$ =",
      "show": "$2x$",
      "hint": "Power rule on $x^2$; the 2 is a constant.",
      "work": "$g' = 2x$"
     },
     {
      "id": "L3.2",
      "type": "expr",
      "answer": "3",
      "vars": [
       "x"
      ],
      "label": "$k'$ =",
      "show": "$3$",
      "hint": "The slope of $3x + 1$.",
      "work": "$k' = 3$"
     },
     {
      "id": "L3.3",
      "type": "expr",
      "text": "Put it together: $gk' + g'k$.",
      "answer": "(x^2 + 2)(3) + 2x(3x + 1)",
      "vars": [
       "x"
      ],
      "label": "$f'(x)$ =",
      "show": "$(x^2 + 2)(3) + 2x(3x + 1)$",
      "hint": "$(x^2 + 2)·3 + 2x·(3x + 1)$",
      "work": "$f'(x) = 3(x^2 + 2) + 2x(3x + 1)$"
     }
    ]
   },
   {
    "id": "L4",
    "type": "steps",
    "text": "**Quotient rule:** $(frac{g}{k})' = frac{kg' - gk'}{k^2}$ (\"low d-high minus high d-low, over low squared\"). Take $f(x) = frac{4x^2}{2x + 1}$.",
    "steps": [
     {
      "id": "L4.1",
      "type": "expr",
      "answer": "8x",
      "vars": [
       "x"
      ],
      "label": "top: $g'$ =",
      "show": "$8x$",
      "hint": "$4x^2 -> 4·2x$",
      "work": "$g' = 8x$"
     },
     {
      "id": "L4.2",
      "type": "expr",
      "answer": "2",
      "vars": [
       "x"
      ],
      "label": "bottom: $k'$ =",
