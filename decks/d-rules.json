{
 "id": "d-rules",
 "course": "Calculus 1",
 "unit": "Derivatives",
 "title": "Derivative Rules",
 "subtitle": "Shortcuts so you never need the limit definition again.",
 "version": 2,
 "graphs": {},
 "drills": {
  "theory": {
   "title": "Theory",
   "mode": "all",
   "questions": [
    {
     "id": "T1",
     "type": "match",
     "text": "Match each rule to its formula.",
     "pairs": [
      [
       "Constant rule",
       "$frac{d}{dx}(c) = 0$"
      ],
      [
       "Power rule",
       "$frac{d}{dx} x^n = nx^(n-1)$"
      ],
      [
       "Constant multiple rule",
       "$frac{d}{dx}(cf) = cf'$"
      ],
      [
       "Sum rule",
       "$(f + g)' = f' + g'$"
      ]
     ],
     "explain": "These four handle every polynomial."
    },
    {
     "id": "T2",
     "type": "mc",
     "text": "The product rule says $(gk)' =$",
     "options": [
      "$gk' + g'k$",
      "$g'k'$",
      "$g'k - gk'$",
      "$frac{g'}{k'}$"
     ],
     "answer": 0,
     "explain": "Each factor takes a turn being differentiated: $gk' + g'k$."
    },
    {
     "id": "T3",
     "type": "tf",
     "text": "The derivative of a product is the product of the derivatives.",
     "answer": false,
     "explain": "No! $(x·x)' = (x^2)' = 2x$, but $(x)'(x)' = 1$."
    },
    {
     "id": "T4",
     "type": "mc",
     "text": "The quotient rule says $(frac{g}{k})' =$",
     "options": [
      "$frac{kg' - gk'}{k^2}$",
      "$frac{gk' - kg'}{k^2}$",
      "$frac{g'}{k'}$",
      "$frac{kg' + gk'}{k^2}$"
     ],
     "answer": 0,
     "explain": "Low d-high minus high d-low, over low squared. The order matters because of the minus sign."
    },
    {
     "id": "T5",
     "type": "mc",
     "text": "To use the power rule on $frac{5}{x^4}$, first rewrite it as",
     "options": [
      "$5x^(-4)$",
      "$5x^4$",
      "$x^(-5)$",
      "$frac{1}{5}x^4$"
     ],
     "answer": 0,
     "explain": "$frac{1}{x^4} = x^(-4)$."
    },
    {
     "id": "T6",
     "type": "mc",
     "text": "$sqrt(x)$ is the same as",
     "options": [
      "$x^(1/2)$",
      "$x^2$",
      "$x^(-2)$",
      "$frac{x}{2}$"
     ],
     "answer": 0,
     "explain": "A square root is the $frac{1}{2}$ power."
    },
    {
     "id": "T7",
     "type": "mc",
     "text": "What is $frac{d}{dx}(pi^2)$?",
     "options": [
      "$0$",
      "$2pi$",
      "$pi^2$",
      "$2x$"
     ],
     "answer": 0,
     "explain": "$pi^2$ is just a number (about 9.87), so its derivative is 0."
    },
    {
     "id": "T8",
     "type": "tf",
     "text": "$(f - g)' = f' - g'$",
     "answer": true,
     "explain": "Derivatives go term by term, sums and differences alike."
    }
   ]
  },
