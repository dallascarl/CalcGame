 "lesson": {
  "slides": [
   {
    "id": "L1",
    "type": "mc",
    "text": "To solve for $y$, undo what is done to it. In $3x + 2y = 6$, first subtract $3x$ from both sides:",
    "options": [
     "$2y = 6 - 3x$",
     "$2y = 6 + 3x$",
     "$y = 6 - 3x$",
     "$3x = 6 - 2y$"
    ],
    "answer": 0,
    "hint": "Move the $3x$ to the other side.",
    "explain": "Then divide by 2: $y = frac{6 - 3x}{2}$."
   },
   {
    "id": "L2",
    "type": "mc",
    "text": "When $y$ is in **two** terms, factor it out: $xy + 2y = 5$ becomes",
    "options": [
     "$y(x + 2) = 5$",
     "$y = 5 - xy - 2$",
     "$2xy = 5$",
     "$y(x + 2y) = 5$"
    ],
    "answer": 0,
    "hint": "Both terms on the left have a $y$.",
    "explain": "Then divide: $y = frac{5}{x + 2}$."
   },
   {
    "id": "L3",
    "type": "expr",
    "text": "The same move finishes implicit differentiation. Solve $xy' + y' = 3$ for $y'$.",
    "answer": "3/(x + 1)",
    "vars": [
     "x"
    ],
    "keys": [
     "y'"
    ],
    "label": "$y'$ =",
    "show": "$frac{3}{x + 1}$",
    "hint": "Factor: $y'(x + 1) = 3$.",
    "explain": "$y' = frac{3}{x + 1}$"
   }
  ]
 },
 "lessonOptional": true
