 "lesson": {
  "slides": [
   {
    "id": "L1",
    "type": "mc",
    "text": "On the unit circle, the point at angle $theta$ is $(cos(theta), sin(theta))$. At $theta = frac{pi}{2}$ (straight up), what is $sin(frac{pi}{2})$?",
    "options": [
     "1",
     "0",
     "−1",
     "$frac{1}{2}$"
    ],
    "answer": 0,
    "hint": "Straight up is the point $(0, 1)$.",
    "explain": "$(cos, sin) = (0, 1)$, so $sin(frac{pi}{2}) = 1$."
   },
   {
    "id": "L2",
    "type": "mc",
    "text": "The special angles: $sin(frac{pi}{6}) = frac{1}{2}$, $sin(frac{pi}{4}) = frac{sqrt(2)}{2}$, $sin(frac{pi}{3}) = frac{sqrt(3)}{2}$. Cosine runs the same list backwards. What is $cos(frac{pi}{3})$?",
    "options": [
     "$frac{1}{2}$",
     "$frac{sqrt(3)}{2}$",
     "$frac{sqrt(2)}{2}$",
     "1"
    ],
    "answer": 0,
    "hint": "$frac{pi}{3}$ is the last in the list, so cosine takes the first value.",
    "explain": "$cos(frac{pi}{3}) = frac{1}{2}$"
   },
   {
