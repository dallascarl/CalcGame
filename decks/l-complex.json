 "lesson": {
  "slides": [
   {
    "id": "L1",
    "type": "mc",
    "text": "Find $lim[x->-3] frac{frac{1}{x + 2} + 1}{x + 3}$. It is $frac{0}{0}$, and there are fractions inside a fraction. First combine the top over a common denominator:",
    "options": [
     "$frac{1}{x + 2} + 1 = frac{x + 3}{x + 2}$",
     "$frac{1}{x + 2} + 1 = frac{2}{x + 2}$",
     "$frac{1}{x + 2} + 1 = frac{1}{x + 3}$",
     "$frac{1}{x + 2} + 1 = x + 3$"
    ],
    "answer": 0,
    "hint": "$1 = frac{x + 2}{x + 2}$",
    "explain": "$frac{1 + (x + 2)}{x + 2} = frac{x + 3}{x + 2}$"
   },
   {
    "id": "L2",
    "type": "steps",
    "text": "Finish it: $frac{(x + 3)/(x + 2)}{x + 3}$.",
    "steps": [
     {
      "id": "L2.1",
      "type": "expr",
      "text": "Dividing by $x + 3$ cancels the $x + 3$ on top. What is left?",
      "answer": "1/(x + 2)",
      "vars": [
       "x"
      ],
      "label": "simplified =",
      "ranges": {
       "x": [
        0.5,
        2
       ]
      },
      "show": "$frac{1}{x + 2}$",
      "hint": "$frac{x + 3}{(x + 2)(x + 3)}$",
      "work": "$= frac{1}{x + 2}$"
     },
     {
      "id": "L2.2",
      "type": "lim",
      "text": "Plug in $x = -3$.",
      "answer": -1,
