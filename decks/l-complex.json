   "questions": [
    {
     "id": "T1",
     "type": "mc",
     "text": "To simplify a fraction inside a fraction, first",
     "options": [
      "combine the small fractions over a common denominator",
      "plug in",
      "multiply by the conjugate",
      "take the derivative"
     ],
     "answer": 0,
     "explain": "Get one fraction, then cancel."
    },
    {
     "id": "T2",
     "type": "tf",
     "text": "$lim[x->0] (frac{1}{x} + frac{5}{x(x - 5)})$ can be done with the sum law, piece by piece.",
     "answer": false,
     "explain": "Each piece has no limit, so the sum law does not apply. Combine first."
    },
    {
     "id": "T3",
     "type": "mc",
     "text": "$frac{a/b}{c}$ is the same as",
     "options": [
      "$frac{a}{bc}$",
      "$frac{ac}{b}$",
      "$frac{a}{b} + c$",
      "$frac{b}{ac}$"
     ],
     "answer": 0,
     "explain": "Dividing by $c$ multiplies the bottom by $c$."
    }
   ]
  },
