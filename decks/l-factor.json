{
 "id": "l-factor",
 "course": "Calculus 1",
 "unit": "Limits",
 "title": "Factor and Cancel",
 "subtitle": "The first trick for 0/0: factor the top and bottom.",
 "version": 2,
 "graphs": {},
 "drills": {
  "theory": {
   "title": "Theory",
   "mode": "all",
   "questions": [
    {
     "id": "T1",
     "type": "mc",
     "text": "Plugging in gives $frac{0}{0}$. A good first move is",
     "options": [
      "factor the top and bottom and cancel",
      "say the limit is 0",
      "say the limit is DNE",
      "say the limit is 1"
     ],
     "answer": 0,
     "explain": "$frac{0}{0}$ means there is a common factor hiding."
    },
    {
     "id": "T2",
     "type": "tf",
     "text": "If $p(a) = 0$ for a polynomial $p$, then $(x - a)$ is a factor of $p(x)$.",
     "answer": true,
     "explain": "The factor theorem."
    },
    {
     "id": "T3",
     "type": "tf",
     "text": "$frac{(x - 2)(x + 2)}{x - 2}$ and $x + 2$ have the same limit as $x -> 2$.",
     "answer": true,
     "explain": "They agree everywhere except $x = 2$."
    },
    {
     "id": "T4",
     "type": "mc",
     "text": "After canceling, you plug in and get $frac{3}{0}$. The limit is",
     "options": [
      "$infty$, $-infty$ or DNE",
      "3",
      "0",
      "still $frac{0}{0}$"
     ],
     "answer": 0,
     "explain": "Now it is an infinite-limit question: check signs."
    },
    {
     "id": "T5",
     "type": "mc",
     "text": "$x^2 - 9$ factors as",
     "options": [
      "$(x - 3)(x + 3)$",
      "$(x - 9)(x + 1)$",
      "$(x - 3)^2$",
      "$x(x - 9)$"
     ],
     "answer": 0,
     "explain": "Difference of squares: $a^2 - b^2 = (a - b)(a + b)$."
    }
   ]
  },
