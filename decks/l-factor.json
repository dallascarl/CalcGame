      ],
      "label": "$x^2 - 1 = (x - 1)·($",
      "post": "$)$",
      "show": "$x + 1$",
      "hint": "Difference of squares.",
      "work": "$frac{(x - 1)(x + 1)}{x - 1}$"
     },
