 "lesson": {
  "slides": [
   {
    "id": "L1",
    "type": "expr",
    "text": "Reduce by factoring and canceling: $frac{x^2 - 4}{x - 2} = frac{(x - 2)(x + 2)}{x - 2}$.",
    "answer": "x + 2",
    "vars": [
     "x"
    ],
    "label": "reduced =",
    "show": "$x + 2$",
    "hint": "Cancel the matching factor.",
    "explain": "$x + 2$"
   },
   {
    "id": "L2",
    "type": "expr",
    "text": "To add fractions, get a common denominator: $frac{1}{x} + frac{1}{x + 1} = frac{(x + 1) + x}{x(x + 1)}$. Simplify the top.",
    "answer": "(2x + 1)/(x(x + 1))",
    "vars": [
     "x"
    ],
    "label": "sum =",
    "show": "$frac{2x + 1}{x(x + 1)}$",
    "hint": "$(x + 1) + x = 2x + 1$",
    "explain": "$frac{2x + 1}{x(x + 1)}$"
   },
   {
    "id": "L3",
    "type": "mc",
    "text": "Only **factors** cancel, never terms. Which one is a correct cancel?",
    "options": [
     "$frac{x(x + 3)}{x} = x + 3$",
     "$frac{x + 3}{x} = 3$",
     "$frac{x^2 + 1}{x} = x + 1$",
     "$frac{x + 5}{5} = x$"
    ],
    "answer": 0,
    "hint": "The thing you cancel has to multiply everything on top.",
    "explain": "In $frac{x + 3}{x}$ the $x$ is added, not multiplied, so it cannot cancel."
   }
  ]
 },
 "lessonOptional": true
}
