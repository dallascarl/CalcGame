 "lesson": {
  "slides": [
   {
    "id": "L1",
    "type": "expr",
    "text": "Pull perfect squares out of a root: $sqrt(50) = sqrt(25·2) = 5sqrt(2)$. Simplify $sqrt(12)$.",
    "answer": "2sqrt(3)",
    "vars": [],
    "keys": [
     "sqrt("
    ],
    "label": "$sqrt(12)$ =",
    "show": "$2sqrt(3)$",
    "hint": "$12 = 4·3$",
    "explain": "$2sqrt(3)$"
   },
   {
    "id": "L2",
    "type": "expr",
    "text": "Conjugates: $(a - b)(a + b) = a^2 - b^2$, and the root disappears. Multiply out $(sqrt(x) - 3)(sqrt(x) + 3)$.",
    "answer": "x - 9",
    "vars": [
     "x"
    ],
    "keys": [
     "sqrt("
    ],
    "label": "product =",
    "show": "$x - 9$",
    "hint": "$(sqrt(x))^2 - 3^2$",
    "explain": "$x - 9$"
   }
  ]
 },
