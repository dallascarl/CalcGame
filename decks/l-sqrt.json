  "theory": {
   "title": "Theory",
   "mode": "all",
   "questions": [
    {
     "id": "T1",
     "type": "mc",
     "text": "The conjugate of $sqrt(x) - 5$ is",
     "options": [
      "$sqrt(x) + 5$",
      "$-sqrt(x) - 5$",
      "$sqrt(x) - 5$",
      "$x - 25$"
     ],
     "answer": 0,
     "explain": "Flip the sign between the terms."
    },
    {
     "id": "T2",
     "type": "mc",
     "text": "$(sqrt(a) - b)(sqrt(a) + b) =$",
     "options": [
      "$a - b^2$",
      "$a + b^2$",
      "$sqrt(a) - b^2$",
      "$a^2 - b^2$"
     ],
     "answer": 0,
     "explain": "Difference of squares; the root disappears."
    },
    {
     "id": "T3",
     "type": "tf",
     "text": "After multiplying by the conjugate, you should multiply out the bottom too.",
     "answer": false,
     "explain": "Leave the bottom factored so the bad factor can cancel."
    },
    {
     "id": "T4",
     "type": "mc",
     "text": "When do you reach for the conjugate?",
     "options": [
      "$frac{0}{0}$ with a square root in it",
      "whenever there is a fraction",
      "when plugging in gives a number",
      "for trig limits"
     ],
     "answer": 0,
     "explain": "It is the square-root trick for $frac{0}{0}$."
    }
   ]
  },
