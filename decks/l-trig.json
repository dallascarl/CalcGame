 "lesson": {
  "slides": [
   {
    "id": "L1",
    "type": "ratio",
    "title": "The famous one",
    "text": "Plugging $x = 0$ into $frac{sin(x)}{x}$ gives $frac{0}{0}$. Move closer and closer to 0 and watch the top and the bottom.",
    "f": "sin(x)",
    "g": "x",
    "op": "/",
    "a": 0,
    "dir": 1,
    "start": 1,
    "goal": 5,
    "after": "Up close, $sin(x)$ and $x$ are almost the same number, so their ratio heads to **1**: $lim[x->0] frac{sin(x)}{x} = 1$."
   },
   {
    "id": "L2",
    "type": "mc",
    "text": "The other one to know: $lim[x->0] frac{1 - cos(x)}{x} =$",
    "options": [
     "0",
     "1",
     "$infty$",
     "DNE"
    ],
    "answer": 0,
    "hint": "The top shrinks much faster than the bottom.",
    "explain": "$lim[x->0] frac{1 - cos(x)}{x} = 0$"
   },
   {
    "id": "L3",
    "type": "steps",
    "text": "Use them with a little algebra. Find $lim[x->0] frac{sin(5x)}{x}$.",
    "steps": [
     {
      "id": "L3.1",
      "type": "num",
      "text": "We want $5x$ on the bottom too. Multiply top and bottom by 5: $frac{sin(5x)}{x} = k·frac{sin(5x)}{5x}$. What is $k$?",
      "answer": 5,
      "label": "$k$ =",
      "hint": "$frac{5}{5} = 1$, so nothing changed.",
      "work": "$= 5·frac{sin(5x)}{5x}$"
     },
     {
      "id": "L3.2",
      "type": "lim",
      "text": "As $x -> 0$, $5x -> 0$ too, so $frac{sin(5x)}{5x} -> 1$.",
      "answer": 5,
      "label": "limit =",
      "hint": "$5·1$",
      "work": "limit $= 5$"
     }
    ]
   },
   {
    "id": "L4",
    "type": "lim",
    "text": "$tan(x) = frac{sin(x)}{cos(x)}$, so $frac{tan(x)}{x} = frac{sin(x)}{x}·frac{1}{cos(x)}$. Find $lim[x->0] frac{tan(x)}{x}$.",
    "answer": 1,
    "label": "limit =",
    "hint": "$1·frac{1}{cos(0)}$",
    "explain": "$1·1 = 1$"
   },
   {
    "id": "L5",
    "type": "lim",
    "text": "From class: $lim[x->0] frac{1 - cos(x)}{sin(x)}$. Divide top and bottom by $x$ and use the limit laws.",
    "answer": 0,
    "label": "limit =",
    "hint": "$frac{(1 - cos(x))/x}{sin(x)/x} -> frac{0}{1}$",
    "explain": "$frac{0}{1} = 0$"
   }
  ]
 }
