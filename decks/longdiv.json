 "graphs": {},
 "lesson": {
  "slides": [
   {
    "type": "steps",
    "text": "Divide $(2x^3 + 3x^2 - x + 5) ÷ (x + 2)$, one move at a time.",
    "steps": [
     {
      "type": "expr",
      "text": "**Divide** the leading terms: $2x^3 ÷ x$ = ?",
      "answer": "2*x^2",
      "vars": [
       "x"
      ],
      "label": "First term =",
      "explain": "$2x^2$ is the first term of the quotient.",
      "hint": "Divide the coefficients, subtract the exponents."
     },
     {
      "type": "expr",
      "text": "**Multiply** it by the divisor: $2x^2(x + 2)$ = ?",
      "answer": "2*x^3+4*x^2",
      "vars": [
       "x"
      ],
      "label": "=",
      "explain": "$2x^3 + 4x^2$.",
      "hint": "Distribute."
     },
     {
      "type": "expr",
      "text": "**Subtract**: $(2x^3 + 3x^2) - (2x^3 + 4x^2)$ = ?",
      "answer": "-x^2",
      "vars": [
       "x"
      ],
      "label": "=",
      "explain": "$-x^2$. Bring down the next term: $-x^2 - x$.",
      "hint": "The $x^3$ terms cancel."
     },
     {
      "type": "expr",
      "text": "Repeat. **Divide**: $-x^2 ÷ x$ = ?",
      "answer": "-x",
      "vars": [
       "x"
      ],
      "label": "Next term =",
      "explain": "$-x$.",
      "hint": "Same move."
     },
     {
      "type": "expr",
      "text": "**Multiply and subtract**: $(-x^2 - x) - (-x)(x + 2)$ = ?",
      "answer": "x",
      "vars": [
       "x"
      ],
      "label": "=",
      "explain": "$x$. Bring down the 5: $x + 5$.",
      "hint": "$(-x)(x + 2) = -x^2 - 2x$."
     },
     {
      "type": "expr",
      "text": "Repeat. **Divide**: $x ÷ x$ = ?",
      "answer": "1",
      "vars": [
       "x"
      ],
      "label": "Next term =",
      "explain": "1.",
      "hint": "Same move."
     },
     {
      "type": "num",
      "text": "**Subtract**: $(x + 5) - 1(x + 2)$ = ? This is the remainder.",
      "answer": 3,
      "label": "Remainder =",
      "explain": "3.",
      "hint": "$x + 5 - x - 2$"
     }
    ],
    "title": "Divide, multiply, subtract, repeat",
    "id": "L1"
   },
   {
    "type": "expr",
    "text": "So $frac{2x^3 + 3x^2 - x + 5}{x + 2}$ = (quotient) + $frac{3}{x + 2}$. What is the quotient?",
    "answer": "2*x^2-x+1",
    "vars": [
     "x"
    ],
    "label": "Quotient =",
    "explain": "$2x^2 - x + 1$.",
    "hint": "Collect the three terms you found.",
    "id": "L2"
   },
   {
    "type": "mc",
    "text": "Dividing $(x^3 - 8) ÷ (x - 2)$, what should you write first?",
    "options": [
     "$x^3 + 0x^2 + 0x - 8$, with placeholders for the missing terms",
     "$(x - 2)(x^3 - 8)$",
     "$x^3 - 8$ as is"
    ],
    "answer": 0,
    "explain": "Missing powers need 0 placeholders so the columns line up.",
    "hint": "Long division needs every power lined up.",
    "id": "L3"
   },
   {
    "type": "expr",
    "text": "Finish it: $(x^3 - 8) ÷ (x - 2)$ = ?",
    "answer": "x^2+2*x+4",
    "vars": [
     "x"
    ],
    "label": "Quotient =",
    "explain": "$x^2 + 2x + 4$, remainder 0 (so $x - 2$ is a factor).",
    "hint": "The remainder is 0.",
    "id": "L4"
   },
   {
    "type": "mc",
    "text": "Why do we need long division in curve sketching?",
    "options": [
     "To find intercepts",
     "To find slant asymptotes: $frac{p}{q}$ = quotient + $frac{remainder}{q}$, and the last piece → 0",
     "To find vertical asymptotes"
    ],
    "answer": 1,
    "explain": "The quotient (when it is linear) is the slant asymptote.",
    "hint": "What happens to $frac{3}{x + 2}$ when $x$ is huge?",
    "id": "L5"
   }
  ]
 },
