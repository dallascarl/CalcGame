   "questions": [
    {
     "id": "T1",
     "type": "mc",
     "text": "$f(3) = 7$ means",
     "options": [
      "the input 3 gives the output 7",
      "$f$ times 3 equals 7",
      "the input 7 gives the output 3",
      "$x$ is both 3 and 7"
     ],
     "answer": 0,
     "explain": "$f(3)$ is read \"f of 3\". It is the output when the input is 3. It is never multiplication."
    },
    {
     "id": "T2",
     "type": "mc",
     "text": "$$f(x) = x^2$$\nWhat is $f(-3)$?",
     "options": [
      "9",
      "−9",
      "6",
      "−6"
     ],
     "answer": 0,
     "explain": "$f(-3) = (-3)^2 = 9$. The parentheses make the minus sign part of what gets squared."
    },
    {
     "id": "T3",
     "type": "mc",
     "text": "$$f(x) = 2x + 1$$\nWhich is $f(x + h)$?",
     "options": [
      "$2(x + h) + 1$",
      "$2x + h + 1$",
      "$2x + 1 + h$",
      "$(2x + 1)(x + h)$"
     ],
     "answer": 0,
     "explain": "Replace the $x$ with $(x + h)$, parentheses and all: $2(x + h) + 1 = 2x + 2h + 1$."
    },
    {
     "id": "T4",
     "type": "tf",
     "text": "For every function, $f(x + h) = f(x) + f(h)$.",
     "answer": false,
     "explain": "Try $f(x) = x^2$: $(x + h)^2 = x^2 + 2xh + h^2$, which is not $x^2 + h^2$. A function does not \"distribute\"."
    },
    {
     "id": "T5",
     "type": "mc",
     "text": "$$f(x) = x^2$$\nWhat is $f(2x)$?",
     "options": [
      "$4x^2$",
      "$2x^2$",
      "$2x$",
      "$x^4$"
     ],
     "answer": 0,
     "explain": "$f(2x) = (2x)^2 = 4x^2$. The 2 is inside the blank, so it gets squared too."
    },
    {
     "id": "T6",
     "type": "tf",
     "text": "$f(x) = 5$ is a constant function. So $f(x + h) = 5 + h$.",
     "answer": false,
     "explain": "The rule has no blank to fill: every input gives 5. So $f(x + h) = 5$."
    }
   ]
  },
