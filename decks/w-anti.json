{
 "id": "w-anti",
 "course": "Calculus 1",
 "unit": "Integration",
 "title": "Antiderivatives",
 "subtitle": "Running the derivative backwards.",
 "version": 2,
 "graphs": {},
 "drills": {
  "theory": {
   "title": "Theory",
   "mode": "all",
   "questions": [
    {
     "id": "T1",
     "type": "mc",
     "text": "$F$ is an antiderivative of $f$ means",
     "options": [
      "$F'(x) = f(x)$",
      "$f'(x) = F(x)$",
      "$F(x) = frac{1}{f(x)}$",
      "$F(x) = f(x) + C$"
     ],
     "answer": 0,
     "explain": "The derivative of the antiderivative gives back $f$."
    },
    {
     "id": "T2",
     "type": "tf",
     "text": "The $+ C$ can be left off of an indefinite integral.",
     "answer": false,
     "explain": "Every antiderivative shifted up or down is still an antiderivative, so the answer is a whole family."
    },
    {
     "id": "T3",
     "type": "mc",
     "text": "How can you check that $int x cos(x) dx = x sin(x) + cos(x) + C$?",
     "options": [
      "Take the derivative of $x sin(x) + cos(x)$",
      "Take the derivative of $x cos(x)$",
      "Plug in $x = 0$",
      "You cannot check it"
     ],
     "answer": 0,
     "explain": "$(x sin(x) + cos(x))' = sin(x) + x cos(x) - sin(x) = x cos(x)$ ✓"
    },
    {
     "id": "T4",
     "type": "mc",
     "text": "$int (f(x) + g(x)) dx =$",
     "options": [
      "$F(x) + G(x) + C$",
      "$F(x)G(x) + C$",
      "$f(x) + g(x) + C$",
      "$F'(x) + G'(x)$"
     ],
     "answer": 0,
     "explain": "Integrals go term by term."
    },
    {
     "id": "T5",
     "type": "mc",
     "text": "$int kf(x) dx$ for a constant $k$ is",
     "options": [
      "$kF(x) + C$",
      "$F(kx) + C$",
      "$k + F(x)$",
      "$frac{F(x)}{k} + C$"
     ],
     "answer": 0,
     "explain": "Constants come out front."
    },
    {
     "id": "T6",
     "type": "mc",
     "text": "The anti-power rule fails for $int x^(-1) dx$. What is it instead?",
     "options": [
      "$ln|x| + C$",
      "$frac{x^0}{0} + C$",
      "$-x^(-2) + C$",
      "$e^x + C$"
     ],
     "answer": 0,
     "explain": "$(ln|x|)' = frac{1}{x}$"
    }
   ]
  },
