{
 "id": "w-ftc",
 "course": "Calculus 1",
 "unit": "Integration",
 "title": "The Fundamental Theorem of Calculus",
 "subtitle": "Areas from antiderivatives, and derivatives of areas.",
 "version": 2,
 "graphs": {},
 "drills": {
  "theory": {
   "title": "Theory",
   "mode": "all",
   "questions": [
    {
     "id": "T1",
     "type": "match",
     "text": "Match each part of the Fundamental Theorem.",
     "pairs": [
      [
       "Part 1",
       "$frac{d}{dx} int[a,x] f(t) dt = f(x)$"
      ],
      [
       "Part 2",
       "$int[a,b] f(x) dx = F(b) - F(a)$"
      ]
     ],
     "explain": "Part 1: differentiating undoes integrating. Part 2: compute areas with antiderivatives."
    },
    {
     "id": "T2",
     "type": "tf",
     "text": "In $F(b) - F(a)$, it does not matter which antiderivative $F$ you use.",
     "answer": true,
     "explain": "$(F(b) + C) - (F(a) + C) = F(b) - F(a)$. The $C$ cancels."
    },
    {
     "id": "T3",
     "type": "mc",
     "text": "$frac{d}{dx} int[a,g(x)] f(t) dt =$",
     "options": [
      "$f(g(x))·g'(x)$",
      "$f(g(x))$",
      "$f(x)g'(x)$",
      "$F(g(x))$"
     ],
     "answer": 0,
     "explain": "Part 1 plus the chain rule."
    },
    {
     "id": "T4",
     "type": "mc",
     "text": "The average value of $f$ on $[a, b]$ is",
     "options": [
      "$frac{1}{b - a} int[a,b] f(x) dx$",
      "$frac{f(a) + f(b)}{2}$",
      "$int[a,b] f(x) dx$",
      "$frac{f(b) - f(a)}{b - a}$"
     ],
     "answer": 0,
     "explain": "Total area divided by the width."
    },
    {
     "id": "T5",
     "type": "mc",
     "text": "What is $int[-pi,pi] sin(x) dx$?",
     "options": [
      "0",
      "2",
      "$-2$",
      "$2pi$"
     ],
     "answer": 0,
     "explain": "$-cos(pi) - (-cos(-pi)) = 1 - 1 = 0$"
    },
    {
     "id": "T6",
     "type": "mc",
     "text": "$int[a,b] f(x) dx$ is a",
     "options": [
      "number",
      "function of $x$",
      "function of $t$",
      "family of functions"
     ],
     "answer": 0,
     "explain": "Definite integrals are numbers."
    }
   ]
  },
