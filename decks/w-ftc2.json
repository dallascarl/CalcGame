      "$2pi$"
     ],
     "answer": 0,
     "explain": "$-cos(pi) - (-cos(-pi)) = 1 - 1 = 0$"
    },
    {
     "id": "T4",
     "type": "mc",
     "text": "$$int[a,b] F'(x) dx =$$",
