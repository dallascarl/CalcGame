  "theory": {
   "title": "Theory",
   "mode": "all",
   "questions": [
    {
     "id": "T1",
     "type": "mc",
     "text": "$int[a,b] F'(x) dx =$",
     "options": [
      "$F(b) - F(a)$",
      "$F'(b) - F'(a)$",
      "$F(a) - F(b)$",
      "$F(b)$"
     ],
     "answer": 0,
     "explain": "The net change theorem."
    },
    {
     "id": "T2",
     "type": "mc",
     "text": "Velocity $v(t)$ is negative for part of a trip. Then $int[a,b] v(t) dt$ gives",
     "options": [
      "the displacement, with backward motion subtracted",
      "the total distance",
      "the top speed",
      "the time traveled"
     ],
     "answer": 0,
     "explain": "For total distance, integrate $|v(t)|$."
    },
    {
     "id": "T3",
     "type": "mc",
     "text": "If $r(t)$ is the rate oil leaks from a tank (gallons per hour), then $int[0,5] r(t) dt$ is",
     "options": [
      "the gallons that leak out in the first 5 hours",
      "the leak rate at hour 5",
      "the gallons left in the tank",
      "how fast the leak speeds up"
     ],
     "answer": 0,
     "explain": "Integrating a rate gives the total amount."
    },
    {
     "id": "T4",
     "type": "tf",
     "text": "An indefinite integral is a number.",
     "answer": false,
     "explain": "It is a family of functions, $F(x) + C$."
    },
    {
     "id": "T5",
     "type": "mc",
     "text": "$int sec^2(x) dx =$",
     "options": [
      "$tan(x) + C$",
      "$sec(x) + C$",
      "$frac{sec^3(x)}{3} + C$",
      "$2sec(x)tan(x) + C$"
     ],
     "answer": 0,
     "explain": "$(tan(x))' = sec^2(x)$"
    }
   ]
  },
