   "questions": [
    {
     "id": "T4",
     "type": "tf",
     "text": "An indefinite integral is a number.",
     "answer": false,
     "explain": "It is a family of functions, $F(x) + C$."
    },
    {
     "id": "T5",
     "type": "mc",
     "text": "$int sec^2(x) dx =$",
     "options": [
      "$tan(x) + C$",
      "$sec(x) + C$",
      "$frac{sec^3(x)}{3} + C$",
      "$2sec(x)tan(x) + C$"
     ],
     "answer": 0,
     "explain": "$(tan(x))' = sec^2(x)$"
    },
    {
     "id": "T6",
     "type": "tf",
     "text": "Two antiderivatives of the same function can differ only by a constant.",
     "answer": true,
     "hint": "That is what the $+ C$ is for.",
     "explain": "If $F' = G'$ on an interval, then $F - G$ is constant there."
    },
    {
     "id": "T7",
     "type": "mc",
     "text": "For $n ≠ -1$,\n$$int x^n dx =$$",
     "options": [
      "$frac{x^(n+1)}{n+1} + C$",
      "$n x^(n-1) + C$",
      "$frac{x^n}{n} + C$",
      "$x^(n+1) + C$"
     ],
     "answer": 0,
     "hint": "Run the power rule backwards.",
     "explain": "Raise the power by one, then divide by the new power."
    },
    {
     "id": "T8",
     "type": "mc",
     "text": "$$int frac{1}{x} dx =$$",
     "options": [
      "$ln|x| + C$",
      "$-frac{1}{x^2} + C$",
      "$frac{x^0}{0} + C$",
      "$x + C$"
     ],
     "answer": 0,
     "hint": "This is the one power the power rule cannot handle.",
     "explain": "The derivative of $ln|x|$ is $frac{1}{x}$."
    },
    {
     "id": "T9",
     "type": "tf",
     "text": "$$int f(x)g(x) dx = int f(x) dx · int g(x) dx$$",
     "answer": false,
     "hint": "Try $f(x) = g(x) = x$.",
     "explain": "With $f = g = x$ the left side is $frac{x^3}{3} + C$ and the right side is about $frac{x^4}{4}$. Integrals split over sums, not products."
    },
    {
     "id": "T10",
     "type": "mc",
     "text": "$$int e^x dx =$$",
     "options": [
      "$e^x + C$",
      "$frac{e^(x+1)}{x+1} + C$",
      "$x e^(x-1) + C$",
      "$ln(x) + C$"
     ],
     "answer": 0,
     "hint": "Which function is its own derivative?",
     "explain": "$e^x$ is its own derivative, so it is its own antiderivative."
    }
   ]
  },
